{
  "name": "stoat-for-web",
  "version": "0.3.0",
  "description": "Stoat for Web: frontend software for Stoat",
  "scripts": {
    "build:deps": "pnpm run build:deps:stoat-js && pnpm run build:deps:livekit && pnpm run build:deps:lingui && pnpm run lingui:compile",
    "build:deps:stoat-js": "pnpm --filter stoat.js build",
    "build:deps:livekit": "pnpm --filter solid-livekit-components build",
    "build:deps:lingui": "pnpm --filter @lingui-solid/babel-plugin-lingui-macro build && pnpm --filter @lingui-solid/babel-plugin-extract-messages build",
    "lingui:compile": "pnpm --filter client exec lingui compile --typescript",
    "typecheck": "pnpm --filter client exec tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.26.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-solid": "^0.14.5",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript-eslint": "^8.54.0"
  },
  "keywords": [],
  "engines": {
    "node": ">=16",
    "pnpm": ">=6"
  },
  "private": true,
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
}
