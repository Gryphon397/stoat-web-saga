From a80149ba9cb5217aef4d02b53f9bede9dc16c47a Mon Sep 17 00:00:00 2001
From: Gryphon397 <jgfillman@gmail.com>
Date: Tue, 31 Mar 2026 01:07:52 -0400
Subject: [PATCH 2/7] fix: rewrite useConnectionQuality with direct LiveKit
 event listener

Replace RxJS observable chain (createConnectionQualityObserver) with a
direct ParticipantEvent.ConnectionQualityChanged listener. Add 5s poll
fallback for setups where events may not fire reliably.
---
 src/signals/useConnectionQuality.ts | 38 ++++++++++++++++++++---------
 1 file changed, 26 insertions(+), 12 deletions(-)

diff --git a/src/signals/useConnectionQuality.ts b/src/signals/useConnectionQuality.ts
index d922808..b1e4b61 100644
--- a/src/signals/useConnectionQuality.ts
+++ b/src/signals/useConnectionQuality.ts
@@ -1,21 +1,35 @@
-// @livekit/components-react@2.0.4
-// Apache-2.0
+// Direct LiveKit event subscription — avoids RxJS observable indirection
+// and handles the Unknown→known transition properly.
 
-import { createConnectionQualityObserver } from '@livekit/components-core'
-import { createMemo } from 'solid-js'
-import { ConnectionQuality } from 'livekit-client'
+import { createSignal, onCleanup, onMount } from 'solid-js'
+import { ConnectionQuality, ParticipantEvent } from 'livekit-client'
 
 import type { Participant } from 'livekit-client'
-import type { Observable } from 'rxjs'
 
 import { useEnsureParticipant } from '../context'
-import { useObservableState } from './internal'
 
 export function useConnectionQuality(participant?: Participant) {
   const p = useEnsureParticipant(participant)
-  const observable = createMemo(
-    () => createConnectionQualityObserver(p) as unknown as Observable<ConnectionQuality>,
-    [p],
-  )
-  return useObservableState(observable(), p.connectionQuality)
+  const [quality, setQuality] = createSignal<ConnectionQuality>(p.connectionQuality)
+
+  onMount(() => {
+    // sync in case quality changed between render and mount
+    setQuality(p.connectionQuality)
+
+    const handler = (q: ConnectionQuality) => setQuality(q)
+    p.on(ParticipantEvent.ConnectionQualityChanged, handler)
+
+    // fallback poll — some LiveKit setups only update quality on change,
+    // so we poll occasionally to catch any silent updates
+    const interval = setInterval(() => {
+      setQuality(p.connectionQuality)
+    }, 5000)
+
+    onCleanup(() => {
+      p.off(ParticipantEvent.ConnectionQualityChanged, handler)
+      clearInterval(interval)
+    })
+  })
+
+  return quality
 }
-- 
